<?xml version="1.0" encoding="utf-8"?>
<!-- AC3 Recomp: el juego recompilado (etapa 6). COMPILACION PERSONAL: contiene codigo
     del juego traducido a C y ACE.BIN, generados desde el disco del usuario.
     NO SE DISTRIBUYE (docs/06-legal.md). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.vzepec.ac3game"
    android:versionCode="6"
    android:versionName="1.5-alfa">

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <application
        android:label="AC3 Recomp"
        android:hasCode="true"
        android:extractNativeLibs="true"
        android:isGame="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode">
            <meta-data android:name="android.app.lib_name" android:value="ac3game" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
