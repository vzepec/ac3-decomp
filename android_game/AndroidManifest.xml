<?xml version="1.0" encoding="utf-8"?>
<!-- AC3 Recomp. Por defecto (build.sh, REGION=libre) es el APK publicable: solo codigo de este
     repositorio; el juego se lee del disco del usuario y se interpreta (docs/12-etapa7.md).
     Las variantes personales (REGION=all/eu/us) llevan codigo del juego y NO se distribuyen. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.vzepec.ac3game"
    android:versionCode="62"
    android:versionName="1.12.4-alfa">

    <!-- actualizador del menu (etapa 7, paso 7): consultar las releases de GitHub y descargar el
         APK nuevo; Android pide confirmacion para instalarlo y solo acepta la misma firma -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- vibracion del DualShock en el motor del aparato o del mando (etapa 7, paso 9) -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <application
        android:label="AC3 Recomp"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:extractNativeLibs="true"
        android:isGame="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
        <!-- menu de inicio (etapa 7, paso 7) -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- tras actualizar desde el menu (Android cierra la app): el menu lo avisara al abrirse -->
        <receiver android:name=".UpdatedReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- el APK descargado, para el instalador de Android -->
        <provider
            android:name=".ApkProvider"
            android:authorities="com.vzepec.ac3game.apk"
            android:exported="false"
            android:grantUriPermissions="true" />
        <!-- el juego, en su propio proceso: al salir termina y se vuelve al menu -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:process=":game"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode">
            <meta-data android:name="android.app.lib_name" android:value="ac3game" />
        </activity>
    </application>
</manifest>
